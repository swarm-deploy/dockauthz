{
  "Description": "State-aware authorization for Docker Engine",
  "Documentation": "https://github.com/swarm-deploy/dockauthz",
  "Entrypoint": ["/usr/bin/dockauthz", "--config", "/etc/dockauthz/config.yaml"],
  "Interface": {"Types": ["docker.authz/1.0"], "Socket": "dockauthz.sock"},
  "Network": {"Type": "bridge"},
  "Mounts": [
    {"Name": "config", "Description": "Root-owned authorization configuration", "Source": "/etc/dockauthz/config.yaml", "Destination": "/etc/dockauthz/config.yaml", "Type": "bind", "Options": ["rbind", "ro"]},
    {"Name": "docker-socket", "Description": "Docker state lookup", "Source": "/var/run/docker.sock", "Destination": "/var/run/docker.sock", "Type": "bind", "Options": ["rbind", "ro"]}
  ],
  "Linux": {"Capabilities": [], "AllowAllDevices": false, "Devices": []},
  "User": {"UID": 0, "GID": 0}
}
